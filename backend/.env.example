# ===== Configuration Backend =====

# Port du serveur
PORT=5000

# Mode environnement
NODE_ENV=development

# ===== Base de données PostgreSQL =====
# Render fournit DATABASE_URL automatiquement pour le service PostgreSQL.
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/erp_gestion_commerciale
# Active SSL hors développement local si nécessaire.
PGSSL=false

# ===== JWT =====
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRY=7d

# ===== CORS =====
CORS_ORIGIN=http://localhost:3000,https://votre-frontend.vercel.app


# ===== Authentification JWT =====
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d

# ===== Configuration CORS =====
CORS_ORIGIN=http://localhost:3000

# Compte administrateur créé automatiquement au démarrage
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_NOM=Administrateur
ADMIN_PRENOM=

# ===== Fichiers PDF =====
PDF_DIRECTORY=./uploads/pdfs
